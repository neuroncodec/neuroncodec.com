@page "/admin/security/change-password"
@model NeuronCodec.Web.Pages.Admin.Security.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["AdminSection"] = "security";
    ViewData["AdminPage"] = "security-password";
}

<div class="admin-header">
    <div>
        <h1>Change password</h1>
        <p>For <strong>@Model.Username</strong>.</p>
    </div>
</div>

@if (Model.IsForced)
{
    <div class="alert alert-error" role="alert">
        This account still uses the password from your environment configuration. Choose a new one
        before using the rest of the admin area.
    </div>
}

<div class="panel" style="max-width:520px">
    <form method="post" class="stack">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"
             style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

        <div class="field">
            <label asp-for="Input.CurrentPassword">Current password</label>
            <input class="input" asp-for="Input.CurrentPassword" type="password"
                   autocomplete="current-password" required autofocus/>
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.NewPassword">New password</label>
            <input class="input" asp-for="Input.NewPassword" type="password"
                   autocomplete="new-password" required minlength="12"/>
            <p class="field-hint">
                At least 12 characters, using three of: lowercase, uppercase, digits, symbols.
            </p>
            <span asp-validation-for="Input.NewPassword" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.ConfirmPassword">Confirm new password</label>
            <input class="input" asp-for="Input.ConfirmPassword" type="password"
                   autocomplete="new-password" required/>
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>

        <div class="row row-end">
            @if (!Model.IsForced)
            {
                <a href="/admin/security" class="btn btn-ghost">Cancel</a>
            }
            <button type="submit" class="btn btn-primary">Change password</button>
        </div>
    </form>
</div>
