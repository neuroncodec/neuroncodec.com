@page "/admin/security"
@model NeuronCodec.Web.Pages.Admin.Security.IndexModel
@{
    ViewData["Title"] = "Security";
    var admin = Model.Admin!;
}

<div class="admin-header">
    <div>
        <h1>Security</h1>
        <p>
            Signed in as <strong>@admin.Username</strong>@(admin.LastLoginAt is { } last
                ? $" · last sign-in {Format.ShortDateTime(last)} UTC"
                : "").
        </p>
    </div>
</div>

@if (!admin.TwoFactorEnabled)
{
    <div class="alert alert-error">
        Two-factor authentication is off — your password alone protects the admin area.
        <a href="/admin/security/two-factor">Turn it on</a>.
    </div>
}
else if (Model.RecoveryCodesRemaining <= 2)
{
    <div class="alert alert-info">
        Only @Model.RecoveryCodesRemaining recovery code@(Model.RecoveryCodesRemaining == 1 ? "" : "s") left.
        <a href="/admin/security/recovery-codes">Generate a new set</a>.
    </div>
}

<div class="settings-grid">
    <a class="card elev-sm settings-link" href="/admin/security/change-password">
        <span class="card-kicker">Password</span>
        <h3 class="card-title">Change your password</h3>
        <p class="card-body">
            Signs out every other browser you are signed in on.
        </p>
        <span class="settings-link-go">Change <partial name="_Icon" model="@("arrow-right")"/></span>
    </a>

    <a class="card elev-sm settings-link" href="/admin/security/two-factor">
        <span class="card-kicker">Two-factor</span>
        <h3 class="card-title">
            Authenticator app
            @if (admin.TwoFactorEnabled)
            {
                <span class="status-pill status-published">On</span>
            }
            else
            {
                <span class="status-pill status-draft">Off</span>
            }
        </h3>
        <p class="card-body">
            @(admin.TwoFactorEnabled
                ? "Sign-in asks for a six-digit code as well as your password."
                : "Add a second step to sign-in using any authenticator app.")
        </p>
        <span class="settings-link-go">
            @(admin.TwoFactorEnabled ? "Manage" : "Set up") <partial name="_Icon" model="@("arrow-right")"/>
        </span>
    </a>

    <a class="card elev-sm settings-link" href="/admin/security/recovery-codes">
        <span class="card-kicker">Recovery codes</span>
        <h3 class="card-title">@Model.RecoveryCodesRemaining of @Model.RecoveryCodesTotal unused</h3>
        <p class="card-body">
            @(admin.TwoFactorEnabled
                ? "Single-use codes for signing in when your authenticator is unavailable."
                : "Generated when you turn two-factor authentication on.")
        </p>
        <span class="settings-link-go">View <partial name="_Icon" model="@("arrow-right")"/></span>
    </a>
</div>
