@page "/admin/security"
@model NeuronCodec.Web.Pages.Admin.Security.IndexModel
@{
    ViewData["Title"] = "Security";
    ViewData["AdminSection"] = "security";
    var admin = Model.Admin!;
}

<div class="admin-header">
    <div>
        <h1>Security</h1>
        <p>
            Signed in as <strong>@admin.Username</strong>@(admin.LastLoginAt is { } last
                ? $" · last sign-in {Format.ShortDateTime(last)} UTC"
                : "").
        </p>
    </div>
    <div class="admin-header-actions">
        <a class="btn btn-secondary" href="/admin/security/change-password">Change password</a>
    </div>
</div>

@if (Model.NewRecoveryCodes is { Count: > 0 })
{
    <div class="panel">
        <div class="panel-head">
            <h2>Save your recovery codes</h2>
            <p>Shown once. Each code works a single time.</p>
        </div>
        <div class="alert alert-error">
            These will not be shown again. Store them somewhere you can reach without this site.
        </div>
        <div class="recovery-grid">
            @foreach (var code in Model.NewRecoveryCodes)
            {
                <span class="recovery-code">@code</span>
            }
        </div>
        <div class="row">
            <button type="button" class="btn btn-secondary"
                    data-copy-text="@string.Join(" ", Model.NewRecoveryCodes)">Copy all</button>
        </div>
    </div>
}

@if (Model.PendingSecret is not null)
{
    <div class="panel">
        <div class="panel-head">
            <h2>Set up two-factor authentication</h2>
            <p>Scan the code with an authenticator app, then confirm.</p>
        </div>

        <div class="totp-setup">
            <div class="qr-frame">@Html.Raw(Model.QrCodeSvg)</div>

            <div class="stack">
                <div>
                    <p class="muted mt-0">Can't scan? Enter this key manually:</p>
                    <div class="secret-code">@Model.PendingSecretDisplay</div>
                    <p class="field-hint">Time-based, six digits, 30-second period.</p>
                </div>

                <form method="post" asp-page-handler="Enable" class="stack">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label for="enable-code">Code from your app</label>
                        <input class="input code-input" id="enable-code" name="Code" inputmode="numeric"
                               autocomplete="one-time-code" maxlength="7" required autofocus/>
                    </div>
                    <div class="row">
                        <button type="submit" class="btn btn-primary">Turn on two-factor</button>
                        <a href="/admin/security" class="btn btn-ghost">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="panel">
        <div class="panel-head">
            <h2>Two-factor authentication</h2>
            <p>
                @if (admin.TwoFactorEnabled)
                {
                    <span class="status-pill status-published">On</span>
                }
                else
                {
                    <span class="status-pill status-draft">Off</span>
                }
            </p>
        </div>

        @if (!admin.TwoFactorEnabled)
        {
            <p class="muted">
                With two-factor on, signing in needs a code from your authenticator app as well as
                your password.
            </p>
            <a href="/admin/security?setup=true" class="btn btn-primary">Set up two-factor</a>
        }
        else
        {
            <p class="muted">
                @Model.RecoveryCodesRemaining unused recovery code@(Model.RecoveryCodesRemaining == 1 ? "" : "s")
                remaining.
            </p>

            <div class="field-row" style="margin-top:var(--space-3)">
                <form method="post" asp-page-handler="RegenerateCodes" class="stack">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label for="regen-code">New recovery codes</label>
                        <input class="input" id="regen-code" name="Code" inputmode="numeric"
                               placeholder="Current code" maxlength="7" required/>
                        <p class="field-hint">Replaces every existing code, used or not.</p>
                    </div>
                    <button type="submit" class="btn btn-secondary">Generate new codes</button>
                </form>

                <form method="post" asp-page-handler="Disable" class="stack"
                      onsubmit="return confirm('Turn off two-factor authentication?')">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label for="disable-code">Turn two-factor off</label>
                        <input class="input" id="disable-code" name="Code" inputmode="numeric"
                               placeholder="Current code" maxlength="7" required/>
                        <p class="field-hint">Your password alone would then protect the admin area.</p>
                    </div>
                    <button type="submit" class="btn btn-ghost danger">Turn off two-factor</button>
                </form>
            </div>
        }
    </div>
}

<div class="panel">
    <div class="panel-head">
        <h2>Password</h2>
    </div>
    <p class="muted">
        Changing your password signs out every other browser you are signed in on.
    </p>
    <a href="/admin/security/change-password" class="btn btn-secondary">Change password</a>
</div>

@section Scripts {
    <script src="~/js/copy-text.js"></script>
}
