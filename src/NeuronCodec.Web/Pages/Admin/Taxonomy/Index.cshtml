@page "/admin/taxonomy"
@model NeuronCodec.Web.Pages.Admin.Taxonomy.IndexModel
@{
    ViewData["Title"] = "Categories & tags";
    ViewData["AdminSection"] = "taxonomy";
}

<div class="admin-header">
    <div>
        <h1>Categories &amp; tags</h1>
        <p>A category sets the coloured pill on an article's card. Tags are the finer grouping.</p>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <h2>Add a category</h2>
    </div>
    <form method="post" asp-page-handler="CreateCategory" class="stack">
        @Html.AntiForgeryToken()
        <div class="field-row">
            <div class="field">
                <label for="new-category-name">Name</label>
                <input class="input" id="new-category-name" name="name" required placeholder="Neuroscience"/>
            </div>
            <div class="field">
                <label for="new-category-class">Pill colour</label>
                <select class="input" id="new-category-class" name="tagClass">
                    @foreach (var option in Model.TagClassOptions)
                    {
                        <option value="@option">@TagClasses.Label(option)</option>
                    }
                </select>
            </div>
        </div>
        <div class="field">
            <label for="new-category-description">Description</label>
            <input class="input" id="new-category-description" name="description"
                   placeholder="Optional, for your own reference"/>
        </div>
        <div class="row row-end">
            <button type="submit" class="btn btn-primary">Add category</button>
        </div>
    </form>
</div>

<div class="panel panel-flush">
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th class="cell-wrap">Category</th>
                <th>Pill</th>
                <th>Articles</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Categories.Count == 0)
            {
                <tr><td colspan="4" class="empty-row">No categories yet.</td></tr>
            }
            @foreach (var row in Model.Categories)
            {
                <tr>
                    <td class="cell-wrap">
                        <form method="post" asp-page-handler="UpdateCategory" class="stack-sm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@row.Category.Id"/>
                            <input class="input" name="name" value="@row.Category.Name" required
                                   aria-label="Category name"/>
                            <input class="input mono" name="slug" value="@row.Category.Slug"
                                   aria-label="Category slug"/>
                            <input class="input" name="description" value="@row.Category.Description"
                                   placeholder="Description" aria-label="Category description"/>
                            <select class="input" name="tagClass" aria-label="Pill colour">
                                @foreach (var option in Model.TagClassOptions)
                                {
                                    <option value="@option" selected="@(row.Category.TagClass == option)">
                                        @TagClasses.Label(option)
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-secondary">Save changes</button>
                        </form>
                    </td>
                    <td><span class="tag @row.Category.TagClass">@row.Category.Name</span></td>
                    <td class="muted">@row.ArticleCount</td>
                    <td class="row-actions">
                        <form method="post" asp-page-handler="DeleteCategory"
                              onsubmit="return confirm('Delete this category? Its articles keep their content but lose the pill.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@row.Category.Id"/>
                            <button type="submit" class="btn btn-ghost danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <h2>Add a tag</h2>
        <p>Tags are also created automatically when you type a new one in the editor.</p>
    </div>
    <form method="post" asp-page-handler="CreateTag" class="row">
        @Html.AntiForgeryToken()
        <input class="input grow" name="name" required placeholder="spike sorting" aria-label="Tag name"/>
        <button type="submit" class="btn btn-primary">Add tag</button>
    </form>
</div>

<div class="panel panel-flush">
    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th class="cell-wrap">Tag</th>
                <th>Slug</th>
                <th>Articles</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Tags.Count == 0)
            {
                <tr><td colspan="4" class="empty-row">No tags yet.</td></tr>
            }
            @foreach (var row in Model.Tags)
            {
                <tr>
                    <td class="cell-wrap">
                        <form method="post" asp-page-handler="RenameTag" class="row">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@row.Tag.Id"/>
                            <input class="input grow" name="name" value="@row.Tag.Name" required
                                   aria-label="Tag name"/>
                            <button type="submit" class="btn btn-secondary">Rename</button>
                        </form>
                    </td>
                    <td class="mono muted">@row.Tag.Slug</td>
                    <td class="muted">@row.ArticleCount</td>
                    <td class="row-actions">
                        <form method="post" asp-page-handler="DeleteTag"
                              onsubmit="return confirm('Delete this tag? It is removed from every article that uses it.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@row.Tag.Id"/>
                            <button type="submit" class="btn btn-ghost danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
