@page "/admin/seo"
@model NeuronCodec.Web.Pages.Admin.Seo.IndexModel
@{
    ViewData["Title"] = "SEO";
}

<div class="admin-header">
    <div>
        <h1>SEO</h1>
        <p>Site-wide defaults. Per-article overrides live in the article editor.</p>
    </div>
    <div class="admin-header-actions">
        <a class="btn btn-secondary" href="/sitemap.xml" target="_blank" rel="noopener">sitemap.xml</a>
        <a class="btn btn-secondary" href="/robots.txt" target="_blank" rel="noopener">robots.txt</a>
        <a class="btn btn-secondary" href="/feed.xml" target="_blank" rel="noopener">feed.xml</a>
    </div>
</div>

@if (!Model.BaseUrlConfigured)
{
    <div class="alert alert-error">
        No canonical base URL is set, so canonical links and the sitemap follow whatever host the
        request arrives on. Behind a proxy or tunnel that is rarely the public address.
        <a href="/admin/seo/identity">Set it under Identity</a>.
    </div>
}

<div class="stat-grid">
    <div class="card elev-sm stat-card">
        <span class="card-kicker">Indexable</span>
        <span class="stat-value">@Model.IndexableCount</span>
    </div>
    <div class="card elev-sm stat-card">
        <span class="card-kicker">Marked noindex</span>
        <span class="stat-value">@Model.NoIndexCount</span>
    </div>
    <div class="card elev-sm stat-card">
        <span class="card-kicker">No description</span>
        <span class="stat-value">@Model.MissingDescriptionCount</span>
    </div>
</div>

<div class="settings-grid">
    <a class="card elev-sm settings-link" href="/admin/seo/identity">
        <span class="card-kicker">01 — Identity</span>
        <h3 class="card-title">Name, tagline and canonical URL</h3>
        <p class="card-body">
            Resolving to <span class="mono">@Model.ResolvedBaseUrl</span>.
            @if (string.IsNullOrWhiteSpace(Model.DefaultMetaDescription))
            {
                <text>No default meta description set.</text>
            }
        </p>
        <span class="settings-link-go">Edit <partial name="_Icon" model="@("arrow-right")"/></span>
    </a>

    <a class="card elev-sm settings-link" href="/admin/seo/sharing">
        <span class="card-kicker">02 — Sharing</span>
        <h3 class="card-title">Open Graph and Twitter cards</h3>
        <p class="card-body">
            @(Model.HasDefaultShareImage
                ? "A default share image is set."
                : "No default share image — links share without a picture.")
        </p>
        <span class="settings-link-go">Edit <partial name="_Icon" model="@("arrow-right")"/></span>
    </a>

    <a class="card elev-sm settings-link" href="/admin/seo/structured-data">
        <span class="card-kicker">03 — Structured data</span>
        <h3 class="card-title">JSON-LD organisation details</h3>
        <p class="card-body">
            @(Model.HasOrganisation
                ? "Organisation details feed the JSON-LD on every page."
                : $"Falling back to the site name, {Model.SiteName}.")
        </p>
        <span class="settings-link-go">Edit <partial name="_Icon" model="@("arrow-right")"/></span>
    </a>

    <a class="card elev-sm settings-link" href="/admin/seo/crawling">
        <span class="card-kicker">04 — Crawling</span>
        <h3 class="card-title">Sitemap and robots.txt</h3>
        <p class="card-body">
            Sitemap is @(Model.SitemapEnabled ? "served and referenced from robots.txt" : "turned off").
        </p>
        <span class="settings-link-go">Edit <partial name="_Icon" model="@("arrow-right")"/></span>
    </a>
</div>
