@page "/admin/seo"
@model NeuronCodec.Web.Pages.Admin.Seo.IndexModel
@{
    ViewData["Title"] = "SEO";
    ViewData["AdminSection"] = "seo";
}

<div class="admin-header">
    <div>
        <h1>SEO</h1>
        <p>Site-wide defaults. Per-article overrides live in the article editor.</p>
    </div>
    <div class="admin-header-actions">
        <a class="btn btn-secondary" href="/sitemap.xml" target="_blank" rel="noopener">sitemap.xml</a>
        <a class="btn btn-secondary" href="/robots.txt" target="_blank" rel="noopener">robots.txt</a>
        <a class="btn btn-secondary" href="/feed.xml" target="_blank" rel="noopener">feed.xml</a>
    </div>
</div>

<div class="stat-grid">
    <div class="card elev-sm stat-card">
        <span class="card-kicker">Indexable</span>
        <span class="stat-value">@Model.IndexableArticleCount</span>
    </div>
    <div class="card elev-sm stat-card">
        <span class="card-kicker">Marked noindex</span>
        <span class="stat-value">@Model.NoIndexArticleCount</span>
    </div>
    <div class="card elev-sm stat-card">
        <span class="card-kicker">No description</span>
        <span class="stat-value">@Model.MissingMetaDescriptionCount</span>
    </div>
</div>

<form method="post" class="stack">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="alert alert-error" role="alert"
         style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="panel">
        <div class="panel-head"><h2>Identity</h2></div>
        <div class="stack">
            <div class="field-row">
                <div class="field">
                    <label asp-for="Input.SiteName">Site name</label>
                    <input class="input" asp-for="Input.SiteName" placeholder="NeuronCodec"/>
                </div>
                <div class="field">
                    <label asp-for="Input.Tagline">Footer tagline</label>
                    <input class="input" asp-for="Input.Tagline" placeholder="open-source foundation"/>
                </div>
            </div>

            <div class="field">
                <label asp-for="Input.BaseUrl">Canonical base URL</label>
                <input class="input mono" asp-for="Input.BaseUrl" type="url"
                       placeholder="https://neuroncodec.com"/>
                <p class="field-hint">
                    Used for canonical links, the sitemap and share tags.
                    Currently resolving to <span class="mono">@Model.ResolvedBaseUrl</span>.
                    Leave blank to use whatever host the request arrives on.
                </p>
                <span asp-validation-for="Input.BaseUrl" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.DefaultMetaDescription">Default meta description</label>
                <textarea class="input" asp-for="Input.DefaultMetaDescription" rows="2" maxlength="400"></textarea>
                <p class="field-hint">Used on pages, and on articles with no description of their own.</p>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Sharing</h2>
            <p>Open Graph and Twitter card defaults.</p>
        </div>
        <div class="stack">
            <div class="field">
                <label>Default share image</label>
                <input type="hidden" asp-for="Input.DefaultOgImageId" id="og-default-id"/>
                <div class="row" id="og-default-slot">
                    @if (Model.DefaultOgImage is not null)
                    {
                        <img src="@Model.DefaultOgImage.Url" alt="" width="140"
                             style="border-radius:var(--radius-sm)"/>
                        <span class="muted">@Model.DefaultOgImage.OriginalName</span>
                    }
                    else
                    {
                        <span class="muted">No default image set.</span>
                    }
                </div>
                <div class="row" style="margin-top:8px">
                    <button type="button" class="btn btn-secondary"
                            data-pick-media="og-default-id" data-slot="og-default-slot">Choose image</button>
                    <button type="button" class="btn btn-ghost"
                            data-clear-media="og-default-id" data-slot="og-default-slot">Clear</button>
                </div>
                <p class="field-hint">Recommended 1200×630. Used when an article has no image of its own.</p>
            </div>

            <div class="field-row">
                <div class="field">
                    <label asp-for="Input.TwitterSite">Twitter site handle</label>
                    <input class="input" asp-for="Input.TwitterSite" placeholder="@@neuroncodec"/>
                </div>
                <div class="field">
                    <label asp-for="Input.TwitterCreator">Twitter creator handle</label>
                    <input class="input" asp-for="Input.TwitterCreator" placeholder="@@neuroncodec"/>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <h2>Structured data</h2>
            <p>Feeds the JSON-LD emitted on the home page and on every article.</p>
        </div>
        <div class="field-row">
            <div class="field">
                <label asp-for="Input.OrganizationName">Organisation name</label>
                <input class="input" asp-for="Input.OrganizationName" placeholder="NeuronCodec"/>
            </div>
            <div class="field">
                <label asp-for="Input.OrganizationLogoUrl">Organisation logo URL</label>
                <input class="input mono" asp-for="Input.OrganizationLogoUrl" placeholder="/logo/mark.svg"/>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head"><h2>Crawling</h2></div>
        <div class="stack">
            <label class="checkbox">
                <input type="checkbox" asp-for="Input.SitemapEnabled"/>
                Serve /sitemap.xml and reference it from robots.txt
            </label>

            <div class="field">
                <label asp-for="Input.RobotsExtra">Extra robots.txt rules</label>
                <textarea class="input mono" asp-for="Input.RobotsExtra" rows="5"
                          placeholder="Disallow: /private"></textarea>
                <p class="field-hint">
                    Appended verbatim. <span class="mono">/admin</span> and
                    <span class="mono">/error</span> are always disallowed.
                </p>
            </div>
        </div>
    </div>

    <div class="row row-end">
        <button type="submit" class="btn btn-primary">Save settings</button>
    </div>
</form>

<partial name="_MediaPickerDialog"/>

@section Scripts {
    <script src="~/js/media-picker.js"></script>
    <script src="~/js/media-slots.js"></script>
}
