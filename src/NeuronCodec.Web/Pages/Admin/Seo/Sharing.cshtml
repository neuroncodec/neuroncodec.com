@page "/admin/seo/sharing"
@model NeuronCodec.Web.Pages.Admin.Seo.SharingModel
@{
    ViewData["Title"] = "SEO — Sharing";
}

<div class="admin-header">
    <div>
        <p class="breadcrumb"><a href="/admin/seo">SEO</a> / Sharing</p>
        <h1>Sharing</h1>
        <p>How a link to this site looks when it is pasted into a chat, a post or a preview card.</p>
    </div>
</div>

<form method="post" class="panel" style="max-width:760px">
    <div class="stack">
        <div class="field">
            <label>Default share image</label>
            <input type="hidden" asp-for="DefaultOgImageId" id="og-default-id"/>
            <div class="row" id="og-default-slot">
                @if (Model.DefaultOgImage is not null)
                {
                    <img src="@Model.DefaultOgImage.Url" alt="" width="160"
                         style="border-radius:var(--radius-sm)"/>
                    <span class="muted">@Model.DefaultOgImage.OriginalName</span>
                }
                else
                {
                    <span class="muted">No default image set.</span>
                }
            </div>
            <div class="row" style="margin-top:10px">
                <button type="button" class="btn btn-secondary"
                        data-pick-media="og-default-id" data-slot="og-default-slot">Choose image</button>
                <button type="button" class="btn btn-ghost"
                        data-clear-media="og-default-id" data-slot="og-default-slot">Clear</button>
            </div>
            <p class="field-hint">
                Recommended 1200×630. Used when an article has no featured or social image of its own.
            </p>
        </div>

        <div class="field-row">
            <div class="field">
                <label asp-for="TwitterSite">Twitter site handle</label>
                <input class="input" asp-for="TwitterSite" placeholder="@@neuroncodec"/>
                <p class="field-hint">The account that owns the site.</p>
            </div>
            <div class="field">
                <label asp-for="TwitterCreator">Twitter creator handle</label>
                <input class="input" asp-for="TwitterCreator" placeholder="@@neuroncodec"/>
                <p class="field-hint">The account credited as the author.</p>
            </div>
        </div>
    </div>

    <div class="row row-end" style="margin-top:var(--space-4)">
        <button type="submit" class="btn btn-primary">Save sharing</button>
    </div>
</form>

<partial name="_MediaPickerDialog"/>

@section Scripts {
    <script src="~/js/media-picker.js"></script>
    <script src="~/js/media-slots.js"></script>
}
